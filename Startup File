-- VERI TABANI YONETIMI
-- BASLANGIC DOSYASI
-- Bu dosyayi YENI VE BOS bir veritabaninda (onerilen: voltride_lab_db)
-- Query Tool uzerinden BIR KEZ calistirin.
-- Mevcut voltride_db veritabaninizdaki eski tablolari silmez.

-- 1) Kategori tablosu
CREATE TABLE kategori (
    kategori_id INTEGER PRIMARY KEY,
    kategori_adi VARCHAR(50) NOT NULL UNIQUE
);

-- 2) Urun tablosu (urun_id 'U101' gibi metinsel kimliktir)
CREATE TABLE urun (
    urun_id VARCHAR(10) PRIMARY KEY,
    urun_adi VARCHAR(100) NOT NULL,
    fiyat NUMERIC(10,2) NOT NULL CHECK (fiyat > 0),
    stok INTEGER NOT NULL DEFAULT 0 CHECK (stok >= 0),
    kategori_id INTEGER NOT NULL,
    CONSTRAINT fk_urun_kategori
        FOREIGN KEY (kategori_id)
        REFERENCES kategori(kategori_id)
);

